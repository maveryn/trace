{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cert.selected_set.v1",
  "title": "Selected-set certificate (chess piece counting)",
  "description": "Public response envelope. JSON Schema cannot express the stricter RFC-JSON rules that the scorer enforces for F: no duplicate keys, no NaN/Infinity, integral floats such as 15.0 (valid 'integer' here) give F=0, annotation_index < len(annotation), and a 16 KiB cap on the final object.",
  "type": "object",
  "properties": {
    "annotation": {
      "description": "Box list, one box per certificate element: at most 64 boxes (the certificate list cap).",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/box"
      }
    },
    "certificate": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "selected_set"
        },
        "members": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "annotation_index": {
                "$ref": "#/$defs/index"
              },
              "color": {
                "enum": [
                  "white",
                  "black"
                ]
              },
              "piece": {
                "enum": [
                  "pawn",
                  "knight",
                  "bishop",
                  "rook",
                  "queen",
                  "king"
                ]
              }
            },
            "required": [
              "annotation_index",
              "color",
              "piece"
            ],
            "additionalProperties": false
          }
        },
        "count": {
          "$ref": "#/$defs/int"
        }
      },
      "required": [
        "kind",
        "members",
        "count"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "integer"
    }
  },
  "required": [
    "annotation",
    "certificate",
    "answer"
  ],
  "additionalProperties": false,
  "$defs": {
    "box": {
      "description": "[x0, y0, x1, y1] in the response frame (px_source or rel1000); finite numbers.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "description": "[x, y] in the response frame; finite numbers.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "box_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/box"
      }
    },
    "int": {
      "type": "integer"
    },
    "index": {
      "description": "0-based position in the annotation list; the upper bound (len(annotation)) is checked by the scorer, not expressible here.",
      "type": "integer",
      "minimum": 0
    }
  }
}
